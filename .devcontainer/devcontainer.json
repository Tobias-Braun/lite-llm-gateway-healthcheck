{
  "name": "factory-agent",
  "dockerComposeFile": "compose.yaml",
  "service": "agent",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/python:1": { "version": "os-provided" },
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "installMaven": "true", "installGradle": "true" }
  },
  "postCreateCommand": "git config --global credential.helper '!gh auth git-credential'",
  "shutdownAction": "stopCompose"
}
