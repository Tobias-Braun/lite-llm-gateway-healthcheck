# Copy to `.env` and fill in the gateway URL and key. Never commit `.env`.

# OpenAI-compatible base URL of the gateway (including /v1) and its API key.
GATEWAY_URL=https://gateway.example.com/v1
API_KEY=sk-replace-me

# Seconds between two check rounds, the per-request timeout, and the minimum spacing between
# the start of two consecutive requests within a round (0 disables pacing).
CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
REQUEST_INTERVAL_SECONDS=2

# Prompt sent to every model in each round.
HEALTHCHECK_PROMPT=Reply with OK.

# Dev mode: skip the gateway and use a built-in model list and synthetic results instead
# (see docs/backend.md).
# GATEWAY_URL and API_KEY stay required but are unused. Lets you try the dashboard without
# a real gateway or API key.
FAKE_DATA=false

# Display name for the dashboard header and API docs. Defaults to "Gateway Health Check".
# APP_TITLE=Gateway Health Check

# SQLite file (relative paths are resolved from the working directory; Docker Compose always
# uses /data/healthcheck.db, inside the persistent volume) and the number of most recent history
# slots (each CHECK_INTERVAL_SECONDS wide) returned per family, and per model in its own history.
# DATABASE_PATH=data/healthcheck.db
HISTORY_LIMIT=50
MODEL_HISTORY_LIMIT=24

# Optional: directory of the built React app, served at / with SPA fallback.
# STATIC_DIR=../frontend/dist

# The models to check are fetched from the gateway (LiteLLM GET /model/info) on startup and
# once a day at a random time in [start, end) hours of the given timezone (see docs/backend.md).
# MODEL_REFRESH_START_HOUR=5
# MODEL_REFRESH_END_HOUR=7
# MODEL_REFRESH_TIMEZONE=Europe/Berlin
