# Copy to `.env` and fill in the gateway URL and key. Never commit `.env`.

# OpenAI-compatible base URL of the gateway (including /v1) and its API key.
GATEWAY_URL=https://gateway.example.com/v1
API_KEY=sk-replace-me

# Seconds between two check rounds, and the per-request timeout.
CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30

# Prompt sent to every model in each round.
HEALTHCHECK_PROMPT=Reply with OK.

# SQLite file (relative paths are resolved from the working directory) and the number of
# most recent check rounds returned per family.
DATABASE_PATH=data/healthcheck.db
HISTORY_LIMIT=50

# Optional: directory of the built React app, served at / with SPA fallback.
# STATIC_DIR=../frontend/dist

# Model families to check, as single-line JSON: [{"title", "models": [{"modelname", "provider", "company"}]}].
# Chat models only; embedding and image models do not support chat completions.
MODEL_FAMILIES='[{"title":"Claude","models":[{"modelname":"claude-fable-5-1","provider":"Google","company":"Anthropic"},{"modelname":"claude-opus-5-5","provider":"Google","company":"Anthropic"},{"modelname":"claude-opus-5","provider":"Google","company":"Anthropic"},{"modelname":"claude-sonnet-5","provider":"Google","company":"Anthropic"},{"modelname":"claude-opus-4-8","provider":"Google","company":"Anthropic"},{"modelname":"claude-opus-4-7","provider":"Google","company":"Anthropic"},{"modelname":"claude-opus-4-6","provider":"Google","company":"Anthropic"},{"modelname":"claude-sonnet-4-6","provider":"Google","company":"Anthropic"},{"modelname":"claude-opus-4-5","provider":"Google","company":"Anthropic"},{"modelname":"claude-sonnet-4-5","provider":"Google","company":"Anthropic"},{"modelname":"claude-haiku-4-5","provider":"Google","company":"Anthropic"}]},{"title":"Gemini","models":[{"modelname":"gemini-3.8-flash","provider":"Google","company":"Google"},{"modelname":"gemini-3.7-flash","provider":"Google","company":"Google"},{"modelname":"gemini-3.6-flash","provider":"Google","company":"Google"},{"modelname":"gemini-3.5-flash","provider":"Google","company":"Google"},{"modelname":"gemini-3.5-flash-lite","provider":"Google","company":"Google"},{"modelname":"gemini-2.5-pro","provider":"Google","company":"Google"},{"modelname":"gemini-2.5-flash","provider":"Google","company":"Google"}]},{"title":"GPT","models":[{"modelname":"gpt-6-sol","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-6-luna","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5.6-sol","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5.6-terra","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5.6-luna","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5.5","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5.4","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5.1","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5-mini","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-5-nano","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-4.1","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-4.1-mini","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-4.1-nano","provider":"Azure","company":"OpenAI"},{"modelname":"gpt-4o","provider":"Azure","company":"OpenAI"},{"modelname":"o4-mini","provider":"Azure","company":"OpenAI"},{"modelname":"o3-mini","provider":"Azure","company":"OpenAI"}]},{"title":"Open-weight / Sovereign","models":[{"modelname":"qwen-3.6-35b-sovereign","provider":"adesso","company":"Alibaba"},{"modelname":"deepseek-v4-flash-sovereign","provider":"adesso","company":"DeepSeek"},{"modelname":"google/gemma-4-31b-it","provider":"StackIT","company":"Google"},{"modelname":"llama-3-3-70b","provider":"StackIT","company":"Meta"},{"modelname":"qwen3.8-27b","provider":"StackIT","company":"Alibaba"},{"modelname":"gpt-oss-120b","provider":"AWS","company":"OpenAI"},{"modelname":"gpt-oss-20b","provider":"AWS","company":"OpenAI"},{"modelname":"qwen3-coder-480b","provider":"AWS","company":"Alibaba"},{"modelname":"qwen3-235b","provider":"AWS","company":"Alibaba"},{"modelname":"devstral-2-123b","provider":"AWS","company":"Mistral AI"},{"modelname":"nemotron-3-super-120b","provider":"AWS","company":"NVIDIA"},{"modelname":"nova-2-lite","provider":"AWS","company":"Amazon"}]}]'
